{
	"FileVersion": 3,
	"Version": 600,
	"VersionName": "0.6.0",
	"FriendlyName": "EngineWire",
	"Description": "Editor automation bridge enabling AI assistants (Claude, Cursor, etc.) to control Unreal Engine via Model Context Protocol (MCP). Provides broad automation coverage for assets, actors, levels, animation, AI, Niagara, materials, foliage, landscapes, and more. Loopback-only by default, with capability-token authentication and optional TLS.",
	"Category": "Editor|Automation|AI",
	"CreatedBy": "ChiR24",
	"CreatedByURL": "https://github.com/ChiR24/Unreal_mcp",
	"DocsURL": "https://github.com/ChiR24/Unreal_mcp#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/ChiR24/Unreal_mcp/discussions",
	"EngineVersion": "5.8.0",
	"CanContainContent": false,
	"Installed": true,
	"SupportedTargetPlatforms": [
		"Win64",
		"Mac",
		"Linux"
	],
